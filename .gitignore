# GitIgnore - Probabilidad y Estadística Inferencial Agentic Core

# Archivos de entorno y secretos
.env
.env.*
*.env

# Python & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter & Notebooks temporales
.ipynb_checkpoints/
*-checkpoint.ipynb

# Material crudo de alumnos y listas de asistencia (privacidad y tamaño)
raw_student_notebooks/
*.zip
PdfViewer.pdf

# Material administrativo/institucional (planeaciones didácticas, fichas
# técnicas del programa oficial). Se conserva localmente en docs/legado/
# pero no se publica en GitHub — mismo patrón que el repo hermano de
# Lógica de Programación.
docs/legado/

# PDFs de bibliografía académica (libros de texto con copyright) para
# referencia del curso y futuro indexado por StatsTutorAgent. Se conservan
# localmente, nunca se publican — mismo criterio que raw_student_notebooks/
# y docs/legado/. El README.md de la carpeta sí se versiona.
bibliografia/*.pdf
bibliografia/*.epub

# Artefactos internos del flujo de trabajo con Claude Code (specs, planes).
# Se conservan localmente pero no se publican en el repo público.
# Excepcion: docs/superpowers/audits/ SI se versiona -- son reportes de
# auditoria/medicion citados desde GOVERNANCE.md, no specs/planes internos.
# (el directorio padre no puede excluirse con "/" al final o git no
# desciende a evaluar las negaciones de sus hijos -- de ahi el "/*".)
docs/superpowers/*
!docs/superpowers/audits/
!docs/superpowers/audits/**

# Excepcion dentro de la excepcion: estas 4 auditorias de proceso interno
# (ingenieria del propio desarrollo, ninguna citada desde GOVERNANCE.md ni
# otro documento publico) se conservan localmente pero no se publican --
# a diferencia de los reportes de A3/N-07/N-05-06-07 de arriba, que SI
# estan citados como evidencia publica y por eso siguen versionados.
docs/superpowers/audits/2026-09-04-auditoria-rubric-15-categorias.md
docs/superpowers/audits/2026-09-11-auditoria-post-cierre-rubric-15-categorias.md
docs/superpowers/audits/2026-09-13-auditoria-post-n01-n02-rubric-15-categorias.md
docs/superpowers/audits/2026-09-14-auditoria-post-camino-a-100.md

# Worktrees locales de ejecución de planes (subagent-driven-development).
.worktrees/

# ChromaDB & Memoria local de Agentes
.chroma/
.tutor_memory.json

# Paquete de distribución para alumnos (PDFs + índice ChromaDB
# pre-generado) -- se genera localmente con
# scripts/empaquetar_distribucion_bibliografia.py, nunca se publica.
dist/

# IDEs & Editores
.vscode/
.idea/
.claude/

# Logs & temporales
*.log
tmp/
tmp_inspect/

# Artefactos de compilación LaTeX (regenerables, no fuente) -- solo se
# versiona el .tex fuente y el .pdf resultado final. (*.log ya cubierto arriba)
*.aux
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# Archivos temporales de Office
~$*

# Backups automaticos del pipeline de autofix editorial
lecciones/.backup/


# Claude Config Manager Extension - Security Rules
# Prevents accidental commit of private conversation data
.claude/.chats/
.claude/.chats/**
.claude/settings.local.json

# Team-sharable Claude Code files (tracked by git):
# .claude/settings.json     # Team settings (official Claude Code)
# .claude/commands/         # Team slash commands (official Claude Code)
# .claude/.plans/           # Project documentation (extension-specific)

# Archivos de solucion generados por las celdas %%writefile de autoevaluacion
# al ejecutar los notebooks localmente (no son fuente, se regeneran).
notebooks/solucion_ejercicio*.py

# Modelos entrenados generados por modelo.save(...) en celdas de ejemplo
# (p.ej. UNIDAD_8 §4, red neuronal probabilistica TFP) -- artefacto de
# ejecucion local, regenerable corriendo la celda, no fuente versionable.
notebooks/*.keras
