# GitIgnore - Probabilidad y Estadística Inferencial Agentic Core

# Archivos de entorno y secretos
.env
.env.*
*.env

# Python & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter & Notebooks temporales
.ipynb_checkpoints/
*-checkpoint.ipynb

# Material crudo de alumnos y listas de asistencia (privacidad y tamaño)
raw_student_notebooks/
*.zip
PdfViewer.pdf

# Material administrativo/institucional (planeaciones didácticas, fichas
# técnicas del programa oficial). Se conserva localmente en docs/legado/
# pero no se publica en GitHub — mismo patrón que el repo hermano de
# Lógica de Programación.
docs/legado/

# Artefactos internos del flujo de trabajo con Claude Code (specs, planes).
# Se conservan localmente pero no se publican en el repo público.
docs/superpowers/

# ChromaDB & Memoria local de Agentes
.chroma/
.tutor_memory.json

# IDEs & Editores
.vscode/
.idea/
.claude/

# Logs & temporales
*.log
tmp/
tmp_inspect/

# Archivos temporales de Office
~$*

# Backups automaticos del pipeline de autofix editorial
lecciones/.backup/

