# GitIgnore - Probabilidad y Estadística Inferencial Agentic Core

# Archivos de entorno y secretos
.env
.env.*
*.env

# Python & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Jupyter & Notebooks temporales
.ipynb_checkpoints/
*-checkpoint.ipynb

# Material crudo de alumnos y listas de asistencia (privacidad y tamaño)
raw_student_notebooks/
*.zip
PdfViewer.pdf

# Material administrativo/institucional (planeaciones didácticas, fichas
# técnicas del programa oficial). Se conserva localmente en docs/legado/
# pero no se publica en GitHub — mismo patrón que el repo hermano de
# Lógica de Programación.
docs/legado/

# PDFs de bibliografía académica (libros de texto con copyright) para
# referencia del curso y futuro indexado por StatsTutorAgent. Se conservan
# localmente, nunca se publican — mismo criterio que raw_student_notebooks/
# y docs/legado/. El README.md de la carpeta sí se versiona.
bibliografia/*.pdf
bibliografia/*.epub

# Artefactos internos del flujo de trabajo con Claude Code (specs, planes).
# Se conservan localmente pero no se publican en el repo público.
docs/superpowers/

# ChromaDB & Memoria local de Agentes
.chroma/
.tutor_memory.json

# Paquete de distribución para alumnos (PDFs + índice ChromaDB
# pre-generado) -- se genera localmente con
# scripts/empaquetar_distribucion_bibliografia.py, nunca se publica.
dist/

# IDEs & Editores
.vscode/
.idea/
.claude/

# Logs & temporales
*.log
tmp/
tmp_inspect/

# Artefactos de compilación LaTeX (regenerables, no fuente) -- solo se
# versiona el .tex fuente y el .pdf resultado final. (*.log ya cubierto arriba)
*.aux
*.out
*.synctex.gz
*.toc
*.fls
*.fdb_latexmk

# Archivos temporales de Office
~$*

# Backups automaticos del pipeline de autofix editorial
lecciones/.backup/


# Claude Config Manager Extension - Security Rules
# Prevents accidental commit of private conversation data
.claude/.chats/
.claude/.chats/**
.claude/settings.local.json

# Team-sharable Claude Code files (tracked by git):
# .claude/settings.json     # Team settings (official Claude Code)
# .claude/commands/         # Team slash commands (official Claude Code)
# .claude/.plans/           # Project documentation (extension-specific)
